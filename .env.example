# ── Public base URL ──────────────────────────────────
# Base URL for the OmniBridge API (used in integration guides).
# Defaults to https://omnibridge-dev.vercel.app/api/v1
OMNIBRIDGE_PUBLIC_BASE_URL=

# ── Database ──────────────────────────────────────────
# Defaults to local SQLite file: ./data/omnibridge.db
# Set these to use Turso (required on Vercel):
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# ── Encryption ────────────────────────────────────────
# 32-byte (64 hex chars) key for AES-256-GCM of API keys
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
